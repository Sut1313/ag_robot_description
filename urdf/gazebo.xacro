<?xml version="1.0"?>
<!-- =====================================================================
     Gazebo Harmonic (gz-sim 8) + gz_ros2_control   (ROS 2 Humble)
     System side:
       sudo apt install gz-harmonic ros-humble-ros-gz ros-humble-gz-ros2-control
     launch/gazebo.launch.py starts `gz sim`, spawns the model with
     ros_gz_sim create and bridges gz's /clock onto ROS so use_sim_time works.
     ===================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="iface_pos" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="iface_vel" params="name">
    <joint name="${name}">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="ctl_arm" params="prefix">
    <xacro:iface_pos name="${prefix}joint1"/>
    <xacro:iface_pos name="${prefix}joint2"/>
    <xacro:iface_pos name="${prefix}joint3"/>
    <xacro:iface_pos name="${prefix}joint4"/>
    <xacro:iface_pos name="${prefix}joint5"/>
    <xacro:iface_pos name="${prefix}joint6"/>
  </xacro:macro>

  <!-- PiPER 夹爪的主关节表示两指总开口宽度（0..0.10 m）。
       两个指爪关节是 mimic 从关节，按 gz_ros2_control 要求仅暴露状态接口，
       不允许控制器单独命令左右手指。 -->
  <xacro:macro name="ctl_gripper" params="prefix">
    <joint name="${prefix}gripper">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.1</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="${prefix}gripper_joint1">
      <param name="mimic">${prefix}gripper</param>
      <param name="multiplier">0.5</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="${prefix}gripper_joint2">
      <param name="mimic">${prefix}gripper</param>
      <param name="multiplier">-0.5</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <ros2_control name="AGRobotSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- 2026-09-23: 原来写的是上一版的 wheel_front_left_joint 等名字, 本版实际是
         wheel_1_joint..wheel_4_joint (见 AG_robot.urdf.xacro), 名字对不上会让
         ros2_control 给不存在的关节声明接口、Gazebo 直接起不来 -->
    <xacro:iface_vel name="wheel_1_joint"/>
    <xacro:iface_vel name="wheel_2_joint"/>
    <xacro:iface_vel name="wheel_3_joint"/>
    <xacro:iface_vel name="wheel_4_joint"/>

    <xacro:iface_pos name="lift_joint"/>
    <xacro:ctl_arm prefix="arm1_"/>
    <xacro:ctl_arm prefix="arm2_"/>
    <xacro:ctl_gripper prefix="arm1_"/>
    <xacro:ctl_gripper prefix="arm2_"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find ag_robot_description)/config/ros2_control.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- 2026-09-25: 这里原来是 <material>Gazebo/Grey</material>。是 Ogre 1.x 的材质脚本名,
       Gazebo Harmonic 的渲染器已不支持 Ogre 脚本(SdfEntityCreator 会报 "does not support
       Ogre material scripts"), 材质赋值失败后回退默认材质(白) —— 车壳和四个轮子就是这么
       变成一片白的。删掉之后, 底盘/立柱/升降台/轮子改用网格自带 .obj/.mtl 的逐部件颜色
       (来自 SolidWorks 零件色: 底盘 0.22 灰、立柱 0.13 深灰、升降台 0.76 浅色、
       轮胎 0.07 近黑配 0.70 浅色轮辋)。要在 Gazebo 侧另配色, 用 SDF 原生写法:
         <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
       不要再写 Gazebo/xxx 这种脚本名。摩擦系数 mu1/mu2 与颜色无关, 保留。 -->
  <xacro:macro name="wheel_gz" params="i">
    <gazebo reference="wheel_${i}">
      <mu1>1.2</mu1><mu2>1.2</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_gz i="1"/><xacro:wheel_gz i="2"/>
  <xacro:wheel_gz i="3"/><xacro:wheel_gz i="4"/>

  <!-- Velodyne VLP-16 仿真参数。外形和安装位姿来自 STEP，扫描参数沿用现有配置：
       16 线，水平 360°，垂直 40°，最大量程 200 m，精度 ±3 cm，最高 20 Hz。
       本仿真采用 10 Hz × 1800 水平采样 × 16 线 = 288000 点/秒；
       需要模拟最大帧率时可把 update_rate 改为 20（约 576000 点/秒）。 -->
  <gazebo reference="velodyne_link">
    <sensor name="velodyne_vlp16" type="gpu_lidar">
      <pose>0 0 0.010 0 0 0</pose>
      <topic>velodyne/scan</topic>
      <gz_frame_id>velodyne_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>1800</samples>
            <resolution>1</resolution>
            <min_angle>-${pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.34906585</min_angle>
            <max_angle>0.34906585</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.5</min>
          <max>200.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <!-- 官方 ±3 cm 精度近似为高斯噪声的 ±3σ，因此 σ 取 1 cm。 -->
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Intel RealSense D435i: 独立 Color + RGBD(Depth/PointCloud) + IMU。
       Gazebo camera 沿传感器 +X 看；optical_frame_id 把消息头切换到 ROS 光学帧
       (+X 右、+Y 下、+Z 前)。内参默认为 librealsense 官方 D435i 参考设备的
       848x480 profile，SDF lens/intrinsics 使 CameraInfo 的 K/P 与渲染投影一致。
       RGBD 自带的 RGB 图像只用于彩色点云生成；对外 RGB 话题由独立 color sensor
       发布，因此 Color 和 Depth 不会共用错误的内参。 -->
  <gazebo reference="camera_link">
    <sensor name="realsense_d435i_depth" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>camera/depth</topic>
      <gz_frame_id>camera_depth_frame</gz_frame_id>
      <update_rate>$(arg camera_update_rate)</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>$(arg camera_depth_hfov)</horizontal_fov>
        <image>
          <width>$(arg camera_depth_width)</width>
          <height>$(arg camera_depth_height)</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>$(arg camera_clip_near)</near>
          <far>$(arg camera_clip_far)</far>
        </clip>
        <depth_camera>
          <clip>
            <near>$(arg camera_clip_near)</near>
            <far>$(arg camera_clip_far)</far>
          </clip>
        </depth_camera>
        <lens>
          <intrinsics>
            <fx>$(arg camera_depth_fx)</fx>
            <fy>$(arg camera_depth_fy)</fy>
            <cx>$(arg camera_depth_cx)</cx>
            <cy>$(arg camera_depth_cy)</cy>
            <s>0.0</s>
          </intrinsics>
        </lens>
        <distortion>
          <k1>0.0</k1><k2>0.0</k2><k3>0.0</k3>
          <p1>0.0</p1><p2>0.0</p2>
          <center>0.5 0.5</center>
        </distortion>
        <optical_frame_id>camera_depth_optical_frame</optical_frame_id>
      </camera>
    </sensor>

    <sensor name="realsense_d435i_color" type="camera">
      <pose>-0.000217729917 0.015078110620 0.000010675736
            -0.000407617216 0.000331054855 -0.003084785990</pose>
      <topic>camera/color/image_raw</topic>
      <gz_frame_id>camera_color_frame</gz_frame_id>
      <update_rate>$(arg camera_update_rate)</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>$(arg camera_color_hfov)</horizontal_fov>
        <image>
          <width>$(arg camera_color_width)</width>
          <height>$(arg camera_color_height)</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>$(arg camera_clip_near)</near>
          <far>$(arg camera_clip_far)</far>
        </clip>
        <lens>
          <intrinsics>
            <fx>$(arg camera_color_fx)</fx>
            <fy>$(arg camera_color_fy)</fy>
            <cx>$(arg camera_color_cx)</cx>
            <cy>$(arg camera_color_cy)</cy>
            <s>0.0</s>
          </intrinsics>
        </lens>
        <distortion>
          <k1>0.0</k1><k2>0.0</k2><k3>0.0</k3>
          <p1>0.0</p1><p2>0.0</p2>
          <center>0.5 0.5</center>
        </distortion>
        <camera_info_topic>camera/color/camera_info</camera_info_topic>
        <optical_frame_id>camera_color_optical_frame</optical_frame_id>
      </camera>
    </sensor>

    <sensor name="realsense_d435i_imu" type="imu">
      <pose>-0.011740000 -0.005520000 0.005100000 0 0 0</pose>
      <topic>camera/imu</topic>
      <gz_frame_id>camera_imu_frame</gz_frame_id>
      <update_rate>$(arg camera_imu_update_rate)</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

</robot>
