<?xml version="1.0"?><!-- =====================================================================
     AG_robot : 四驱底盘 + 升降立柱/导轨 + 双 PiPER + 头部 RGB-D / 3D 雷达

     几何来源
       底盘与升降结构: D:\AG_robot\robot_model\升降平台.SLDASM 导出的 STEP
                       (升降平台.step 70.6 MB + 顶配独立悬挂四驱车.step 60.4 MB),
                       由 OpenCASCADE 提取体积/质心/包围盒并做网格
       机械臂:         官方 agx_arm_urdf/piper (urdf/piper_arm.xacro), 参数原文照搬
       头部与传感器:   C:\Users\LENOVO\Desktop\robot_model(1).STEP (SolidWorks 2025)

     坐标系(本文件内部) = SolidWorks 装配体坐标:
         +X = 左右,  -Y = 车头方向,  +Z = 竖直向上
     注意这与 ROS 约定不同(x 前 y 左 z 上), 所以 base_joint 用 rpy=(0,0,+pi/2) 转进 ROS。

     网格单位不一样, 别搞混:
       底盘/轮子/立柱/升降台 (chassis, wheel_*, base_frame, platform)  毫米 -> scale="0.001 0.001 0.001"
       机械臂 (piper_*)                                              米   -> 不要 scale

     结构
       base_footprint
       └─ base_link                 整车底盘 (轮子/悬挂/电控/车架/顶板)
          ├─ wheel_1..4            四轮, continuous, 差速驱动
          ├─ base_frame_link       立柱+导轨+推杆 (固定)
          │  ├─ head_link          130x130x128 mm 保护壳
          │  │  ├─ camera_link     Intel RealSense D435i + RGB/Depth/IMU frames
          │  │  └─ velodyne_link   VLP-16, 可用 lidar_pitch 做安装姿态试验
          │  └─ lift_platform_link 升降台, 沿立柱 Z 向滑动
          │     ├─ arm1_*          松灵 PiPER + 平行夹爪
          │     └─ arm2_*          松灵 PiPER + 平行夹爪

     传感器:
       头部保护壳、RealSense D435i 与 VLP-16 均使用 robot_model(1).STEP 的精确外形与安装位姿。
       Gazebo RGB / Depth 分路建模；默认内参来自 librealsense 官方 D435i 848x480
       参考设备数据，并保留为 xacro 参数，拿到本机标定后可直接覆盖。
     ===================================================================== -->
<robot name="AG_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ag_robot_description)/urdf/piper_arm.xacro"/>

  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>
  <!-- .obj 是 SolidWorks 以"米"导出的(与 .stl 几何完全一致、只差 1000 倍单位), 所以
       不能套 .stl 那个 0.001 的 scale, 否则视觉体缩到 1/1000、整车只剩 0.55 mm。 -->
  <xacro:property name="mesh_scale_obj" value="1 1 1"/>
  <!-- 2026-09-25 颜色说明(实测结论):
       .obj 视觉体在 Gazebo Harmonic 里**不能上色** —— assimp 加载 .obj 时会带上一份内嵌材质,
       而网格自带材质优先于 visual/SDF 上的材质, 结果无论 URDF 写什么颜色都渲染成默认白。
       实测: 放一个纯 box + 显式 SDF 材质能渲染出洋红(RGB 0.56 0.09 0.56),
       但同样的材质挂到 .obj 网格上无效; .dae(机械臂)自带材质正确所以一直有颜色。
       所以车体件统一改用**无内嵌材质**的 .stl(与碰撞网格同一个文件, 毫米制, scale 0.001),
       颜色由下面对每个 visual 写的 <material> 决定。要恢复 .obj 只需把 visual 的
       filename 改回 .obj、scale 改回 ${mesh_scale_obj}, 但那样在 Gazebo 里会变白模。 -->
  <xacro:arg name="lift_travel" default="0.40"/>
  <xacro:arg name="use_gazebo"  default="false"/>
  <xacro:arg name="arm1_prefix" default="arm1_"/>
  <xacro:arg name="arm2_prefix" default="arm2_"/>
  <!-- ═════════ 雷达安装倾角（参数化, 供 SLAM 对比姿态）═════════
       lidar_pitch 单位: 度; 正值 = 朝车头方向(head_link 的 -Y)下倾。
       STEP 中默认水平安装。velodyne_link 仍取雷达本体高度中心，扫描面仍在 link +Z 10 mm，
       因而原有 blind-zone / target-check 脚本的 frame 和 Z_SENSOR=0.010 均保持兼容。
       精确网格相对 link: z=[-36,+36] mm、车头侧最远 y=-51.65 mm；倾斜时按此外廓
       抬高中心，使最低点始终保持 STEP 默认的 z=-7 mm 嵌入量，不会额外穿入保护壳。
       head_link 原点到雷达 CAD 底面为 121 mm，所以：
         z(pitch) = 0.121 + 0.036*cos(pitch) + 0.05165*sin(pitch) -->
  <xacro:arg name="lidar_pitch" default="0"/>
  <xacro:property name="lidar_pitch_deg" value="$(arg lidar_pitch)"/>
  <xacro:property name="lidar_pitch_rad" value="${radians(float(lidar_pitch_deg))}"/>
  <xacro:property name="velodyne_z"
                  value="${0.121 + 0.036*cos(lidar_pitch_rad) + 0.05165*sin(lidar_pitch_rad)}"/>

  <!-- Intel RealSense D435i 仿真默认参数。
       - 848x480@30 同时属于官方支持的 Depth(Z16) 和 Color(YUYV) profile。
       - fx/fy/cx/cy 来自 librealsense unit-tests/dds/d435i.py 的官方参考设备。
       - 内参和 RGB<->Depth 外参会有设备间差异；实机标定值优先，因此都保留
         为启动参数，不需要改话题或消费端。
       - near=0.28 m 是官方产品页给出的最大分辨率 Min-Z；far=10 m 是仿真上限，
         官方建议的理想工作距离为 0.3..3 m。 -->
  <xacro:arg name="camera_depth_width"       default="848"/>
  <xacro:arg name="camera_depth_height"      default="480"/>
  <xacro:arg name="camera_depth_fx"          default="418.2646789550781"/>
  <xacro:arg name="camera_depth_fy"          default="418.2646789550781"/>
  <xacro:arg name="camera_depth_cx"          default="424.1576232910156"/>
  <xacro:arg name="camera_depth_cy"          default="238.23983764648438"/>
  <xacro:arg name="camera_depth_hfov"        default="1.5844149256643074"/>
  <xacro:arg name="camera_color_width"       default="848"/>
  <xacro:arg name="camera_color_height"      default="480"/>
  <xacro:arg name="camera_color_fx"          default="605.3924560546875"/>
  <xacro:arg name="camera_color_fy"          default="605.6131591796875"/>
  <xacro:arg name="camera_color_cx"          default="428.64471435546875"/>
  <xacro:arg name="camera_color_cy"          default="241.26548767089844"/>
  <xacro:arg name="camera_color_hfov"        default="1.2219513360956136"/>
  <xacro:arg name="camera_clip_near"         default="0.28"/>
  <xacro:arg name="camera_clip_far"          default="10.0"/>
  <xacro:arg name="camera_update_rate"       default="30.0"/>
  <xacro:arg name="camera_imu_update_rate"   default="200.0"/>
  <xacro:property name="arm1_prefix" value="$(arg arm1_prefix)"/>
  <xacro:property name="arm2_prefix" value="$(arg arm2_prefix)"/>

  <!-- 2026-09-25 调色: 原来 grey(0.55 0.60 0.71)/alu(0.75 0.76 0.78) 都太浅,
       而且 sdformat 把 URDF 颜色转 SDF 时统一 ×1.25 (0.75 -> 0.94), 整车看起来一片白。
       现在按部件拉开层次: 底盘深钢灰 / 立柱中灰 / 升降台与导轨亮铝 / 轮胎近黑。 -->
  <material name="grey"><color rgba="0.28 0.30 0.34 1.0"/></material>
  <material name="steel"><color rgba="0.52 0.54 0.57 1.0"/></material>
  <material name="black"><color rgba="0.06 0.06 0.07 1.0"/></material>
  <material name="blue"><color rgba="0.20 0.40 0.90 1.0"/></material>
  <material name="red"><color rgba="0.85 0.20 0.20 1.0"/></material>
  <material name="alu"><color rgba="0.78 0.79 0.81 1.0"/></material>
  <material name="dark"><color rgba="0.22 0.22 0.24 1.0"/></material>
  <material name="velodyne_blue"><color rgba="0.05 0.22 0.42 1.0"/></material>
  <!-- robot_model(1).STEP 的唯一 SolidWorks 表面色（87 个 styled item 完全一致）。 -->
  <material name="cad_head_surface"><color rgba="0.792157 0.819608 0.933333 1.0"/></material>
  <!-- piper_arm.xacro 的 link2/link5 引用 accent, 本包必须自己定义一份,
       否则 urdf 解析会报 "material 'accent' undefined" 并退回 RViz 默认色。
       取值与 piper_lift_ws 那个包保持一致, 同样的两条臂用同一个配色。 -->
  <material name="accent"><color rgba="0.13 0.42 0.85 1.0"/></material>
  <!-- ═════════ base_footprint: 地面投影, Nav2 用 ═════════
       轮子最低点在 base_link 里是 z=-218.49, 所以 base_link 抬高 218.49 mm -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.2184858" rpy="0 0 1.5707963"/>
  </joint>

  <!-- ═════════ base_link: 底盘 ═════════
       27 个零件合成: 车架(2020 型材x4 + 2040 型材x2)、顶板 460x550x2、
       4 套 MD60 独立悬挂(不含轮)、Orin Nano、24V6100mAh 电池、驱动板等
       惯量按合并网格包围盒算的近似值

       + rail.stl: 固定在底盘上的平置 3030 导轨 (2026-09-23 修正)
         3 根水平型材: Y=260 的 500mm、X=±90 的两根 300mm,
         以及只与它们相连的 4 个角码 (Y≈228)。
         这些固定在底盘上、不随升降台运动, 原先误归在 lift_platform_link 里。
         单独成 rail.stl 而不是并进 chassis.stl, 是为了沿用 alu 材质
         (并进底盘会跟着变成 grey, 外观就变了)。 -->
  <link name="base_link">
    <visual>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/chassis.stl"/></geometry>
      <!-- 同一 link 里第二个 visual 用 <material name="..."/> 引用时, sdformat 转出来的
           diffuse 会变成 0 0 0(纯黑), 所以 base_link 这两处改用内联颜色。 -->
      <material name="grey"><color rgba="0.28 0.30 0.34 1.0"/></material>
    </visual>
    <collision>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/chassis.stl"/></geometry>
    </collision>
    <!-- 固定在底盘上的整套平置导轨 -->
    <visual>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/rail.stl"/></geometry>
      <material name="alu"><color rgba="0.78 0.79 0.81 1.0"/></material>
    </visual>
    <collision>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/rail.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.000000 0.000000 -0.052246" rpy="0 0 0"/>
      <mass value="19.352"/>
      <inertia ixx="0.539215" ixy="0" ixz="0" iyy="0.533908" iyz="0" izz="0.970366"/>
    </inertial>
  </link>

  <!-- ═════════ imu_link: IMU 坐标系 (2026-09-24 新增) ═════════
       IMU 集成在主控(Orin)上、没有独立安装件, 所以这里只给一个坐标系、不建几何。
       XY 居中 (X=0, Y=0); Z 按实测取 base_link 下方 0.0754 m, 即 origin = (0, 0, -0.0754) m。
       base_link 的原点就是顶板下表面 (顶板 460x550x2, CAD Z 0..2), 所以 IMU 落在顶板
       下方 75.4 mm、车体内部。
       换算到 ROS 世界系(base_footprint): (0, 0, 0.1431) m —— base_joint 只绕 Z 旋转,
       高度 0.2185 减去 0.0754。
       用途: 发布 sensor_msgs/Imu 时用这个 frame; IMU 若装在别处, 改下面的 origin 即可。 -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <!-- X=0, Y=0, Z = base_link 下方 0.0754 m -->
    <origin xyz="0 0 -0.0754" rpy="0 0 0"/>
  </joint>

  <link name="wheel_1">
    <visual>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/wheel_1.stl"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/wheel_1.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.0072004 0" rpy="0 0 0"/>
      <mass value="5.471"/>
      <inertia ixx="0.026585" ixy="0" ixz="0" iyy="0.046979" iyz="0" izz="0.026585"/>
    </inertial>
  </link>

  <joint name="wheel_1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_1"/>
    <origin xyz="-0.3019 0.2010084 -0.1049916" rpy="0 0.2807556 -1.5707963"/>
    <axis xyz="0 -1 0"/>
    <limit effort="50" velocity="20"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <link name="wheel_2">
    <visual>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/wheel_2.stl"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/wheel_2.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.0072004 0" rpy="0 0 0"/>
      <mass value="5.471"/>
      <inertia ixx="0.026585" ixy="0" ixz="0" iyy="0.046979" iyz="0" izz="0.026585"/>
    </inertial>
  </link>

  <joint name="wheel_2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_2"/>
    <origin xyz="0.3019 0.2010084 -0.1049916" rpy="0 0.2807556 1.5707963"/>
    <axis xyz="0 1 0"/>
    <limit effort="50" velocity="20"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <link name="wheel_3">
    <visual>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/wheel_3.stl"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/wheel_3.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.0072004 0" rpy="0 0 0"/>
      <mass value="5.471"/>
      <inertia ixx="0.026585" ixy="0" ixz="0" iyy="0.046979" iyz="0" izz="0.026585"/>
    </inertial>
  </link>

  <joint name="wheel_3_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_3"/>
    <origin xyz="-0.3019 -0.1989916 -0.1049916" rpy="0 0.2807556 -1.5707963"/>
    <axis xyz="0 -1 0"/>
    <limit effort="50" velocity="20"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <link name="wheel_4">
    <visual>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/wheel_4.stl"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/wheel_4.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.0072004 0" rpy="0 0 0"/>
      <mass value="5.471"/>
      <inertia ixx="0.026585" ixy="0" ixz="0" iyy="0.046979" iyz="0" izz="0.026585"/>
    </inertial>
  </link>

  <joint name="wheel_4_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_4"/>
    <origin xyz="0.3019 -0.1989916 -0.1049916" rpy="0 0.2807556 1.5707963"/>
    <axis xyz="0 1 0"/>
    <limit effort="50" velocity="20"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <!-- ═════════ base_frame_link: 立柱 + 立柱后侧导轨 + 推杆 (固定) ═════════
       立柱本体(两块约 150x85x900) + FBX150 行程700mm 电动推杆 + 角码/T型螺母
       + 立柱后侧(=CAD Y 正侧)的一副导轨: 2 根竖直 3030 型材(300mm, X=±90, Y=-85..-55)
         + 与二者底部相连的横向导轨(500mm, Y=-85..-55) + T 型螺母(夹在立柱面与横导轨之间)。
       依据: "CAD -Y = 车头" (见 package.xml "mounted at the front" 与机械臂位于 Y=-187..-89),
       所以 Y 正侧是车尾方向, 你确认过这副导轨固定在立柱上、不动。
       2026-09-24: 原先归在本 link、但实际随升降台运动的一批立柱内部件已搬出 ->
       platform.stl / lift_platform_link: 4 个 U 形滑套(各 1036 面)、2 个小合页件(各 4046 面)、
       1 个几字折滑座(10162 面, 带 6 个螺孔与 6 个三角形角码对应)。共 22398 面 / 1.680 kg。
       按本轮要求立柱不做联动 (固定)。 -->
  <link name="base_frame_link">
    <visual>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/base_frame.stl"/></geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/base_frame.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.000000 -0.114898 0.455004" rpy="0 0 0"/>
      <mass value="25.293"/>
      <inertia ixx="1.783345" ixy="0" ixz="0" iyy="2.280038" iyz="0" izz="0.557192"/>
    </inertial>
  </link>

  <joint name="base_frame_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_frame_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ═════════ lift_platform_link: 升降台 (滑动) ═════════
       运动件 = 立柱前方(=CAD Y 负侧)那两根竖直 3030 导轨 (200mm, X=±50.5, Y=-207..-177)
       + 与二者底部相连的横向导轨 (300mm, Y=-207..-177) + 坐在该横导轨上的 4 个角码
       + 沿竖直导轨同轴堆叠的 6 个卡子 (X=±(64..100.5), Z=60.5..208.5, 卡在立柱侧向凹槽里滑)
       + 两块 Γ 形机械臂托板 (X=±(150..250), Y=-295..-113) + 嵌在板上的 6 个角码
       + 立柱内部随动件 (2026-09-24 从 base_frame_link 搬来, 共 22398 面 / 1.680 kg):
         4 个 U 形滑套 (34.6x28x39.6, 各 1036 面, 打开口 16mm 抱住 X=±46 的 Φ17x839 导杆)
         + 2 个小合页件 (7x15.6x8, 各 4046 面, 一个嵌在左侧滑套内、一个嵌在左侧卡子摞里)
         + 1 个几字折滑座 (177x64.6x150, 10162 面, 板件折出两处几字形、带 6 个螺孔,
           与 6 个三角形角码一一对应, 卡在立柱轨道内滑移),
       共 28 个零件。升降台靠这些卡子/滑座在立柱两侧的竖向凹槽里上下滑移。
       机械臂安装位: 按实测, arm1 xyz=(0.187732,-0.249047,0.032)、arm2 xyz=(-0.190000,-0.247667,0.032)
       (两臂相距 377.732mm, 中点偏 -1.134mm, Z=32 即托板顶面) —— 见下方 arm 的 origin。
       同轴堆叠的角码必须与本 link 同属一个 link: 6 个卡子与横导轨上的 4 个角码在同一根
       竖直线、只差高度, 拆开会让升降时两者对穿 (实测相交 22000+ mm³)。
       轴 (0,0,1) = 本文件坐标系的 Z = 竖直向上 = 立柱竖向凹槽的方向。
       lower=0 因为 CAD 姿态就是行程下限(平台在最低位)。
       注意: 新模型里**没有建导轨卡进凹槽的滑块本体**。 -->
  <joint name="lift_joint" type="prismatic">
    <parent link="base_frame_link"/>
    <child link="lift_platform_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="$(arg lift_travel)" effort="2000" velocity="0.15"/>
    <dynamics damping="50.0" friction="20.0"/>
  </joint>

  <link name="lift_platform_link">
    <visual>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/platform.stl"/></geometry>
      <material name="alu"/>
    </visual>
    <collision>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/platform.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.000000 -0.202447 0.117000" rpy="0 0 0"/>
      <mass value="3.602"/>
      <inertia ixx="0.026183" ixy="0" ixz="0" iyy="0.090914" iyz="0" izz="0.085342"/>
    </inertial>
  </link>

  <!-- ═════════ 头部保护壳（STEP 精确网格）═════════
       STEP component: 头盔_原始备份_20260925_084324
       base_frame_link 中的安装原点 = (0, -0.121796720, 0.911) m（壳体底面中心）
       link 局部包围盒 = [-65,-65,0]..[65,65,128] mm。
       STEP 没有导出密度 / 质量属性，1.0 kg 与惯量是均质包围盒估算，待实测后替换。 -->
  <link name="head_link">
    <visual>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/head_shell.stl"/></geometry>
      <material name="cad_head_surface"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.064" rpy="0 0 0"/>
      <geometry><box size="0.130 0.130 0.128"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 -0.000183071 0.071289575" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.002773667" ixy="0" ixz="0"
               iyy="0.002773667" iyz="0" izz="0.002816667"/>
    </inertial>
  </link>

  <joint name="head_joint" type="fixed">
    <parent link="base_frame_link"/>
    <child link="head_link"/>
    <origin xyz="0 -0.121796720 0.911" rpy="0 0 0"/>
  </joint>

  <!-- ═════════ Intel RealSense D435i（STEP 精确网格 + REP-103 frames）═════════
       STEP component origin 换算到 base_frame_link =
         (0.006445351, -0.211853206, 0.991065428) m。
       camera_link 采用 ROS REP-103: +X 前、+Y 左、+Z 上；在保护壳坐标中 yaw=-pi/2。
       网格局部包围盒 = x[-25.05,0], y[-45,45], z[-12.5,12.5] mm，前表面即 x=0。
       camera_depth_frame 取为设备主坐标；color/IMU 的默认外参来自 librealsense
       官方 D435i 参考设备。光学帧均符合 ROS: +X 右、+Y 下、+Z 前。 -->
  <link name="camera_link">
    <visual>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/realsense_d435i.stl"/></geometry>
      <material name="cad_head_surface"/>
    </visual>
    <collision>
      <origin xyz="-0.012525 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02505 0.090 0.025"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.012949985 -0.000005603 0.000055389" rpy="0 0 0"/>
      <mass value="0.072"/>
      <inertia ixx="0.000052350" ixy="0" ixz="0"
               iyy="0.000007515" iyz="0" izz="0.000052365"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="head_link"/>
    <child link="camera_link"/>
    <origin xyz="0.006445351 -0.090056487 0.080065428" rpy="0 0 -1.570796327"/>
  </joint>

  <link name="camera_color_frame"/>
  <joint name="camera_color_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
    <!-- 官方参考外参 Color->Depth 转成 REP-103 camera_link 坐标。
         此处是参考设备值，实机 librealsense 导出值应优先。 -->
    <origin xyz="-0.000217729917 0.015078110620 0.000010675736"
            rpy="-0.000407617216 0.000331054855 -0.003084785990"/>
  </joint>
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327"/>
  </joint>

  <link name="camera_depth_frame"/>
  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327"/>
  </joint>

  <!-- D435i Motion->Depth 外参由机械图纸预标定。下值由官方参考设备的
       optical 坐标 (+5.52,-5.10,-11.74) mm 转为 REP-103 body 坐标。
       IMU 输出轴与 camera_link 保持一致，便于 robot_localization 直接使用。 -->
  <link name="camera_imu_frame"/>
  <joint name="camera_imu_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_imu_frame"/>
    <origin xyz="-0.011740000 -0.005520000 0.005100000" rpy="0 0 0"/>
  </joint>

  <!-- ═════════ Velodyne VLP-16（STEP 精确网格）═════════
       STEP 默认本体中心在 base_frame_link (0, -0.121796720, 1.068) m；
       局部包围盒 103.300 x 143.300 x 72 mm（后方插头使 Y 尺寸大于圆柱本体）。
       仍沿用 0.59 kg；collision 用主体包络圆柱，避免复杂视觉网格拖慢物理引擎。 -->
  <link name="velodyne_link">
    <visual>
      <geometry><mesh scale="${mesh_scale}" filename="package://ag_robot_description/meshes/vlp16.stl"/></geometry>
      <material name="cad_head_surface"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.051650" length="0.072"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.59"/>
      <inertia ixx="0.000648369" ixy="0" ixz="0"
               iyy="0.000648369" iyz="0" izz="0.000786978"/>
    </inertial>
  </link>

  <joint name="velodyne_joint" type="fixed">
    <parent link="head_link"/>
    <child link="velodyne_link"/>
    <origin xyz="0 0 ${velodyne_z}" rpy="${lidar_pitch_rad} 0 0"/>
  </joint>

  <!-- ═════════ 两条松灵 PiPER 六轴臂 ═════════
       臂本体参数取自官方 agx_arm_urdf/piper (见 urdf/piper_arm.xacro), 网格是米制不用 scale。

       安装位姿由新建模 robot_model.STEP 反求(2026-09-24 二次修正):
         base_link = Rz180 * STEP + (-108.2168, -96.7167, -843.5)   [毫米, 绕Z转180度再平移]
         这个读法由四项独立证据确认:
           建模的 200mm 竖直导轨 -> Y -207.0..-177.0, 与 platform.stl 网格(-211.4..-171.1)
                                    以及 xacro 里原来的注释(Y=-207..-177)一致
           推杆 FBX150        -> Y -174.8..-86.8, 落在 base_frame.stl(-199.8..-55) 内
           臂基座 J12          -> 完全落在 platform.stl 范围内, 底面对齐其 Z=32 面(406~551 个面片接触)
           轮子                -> 两种读法下是同一组, 不受影响
         ==> 车头 = base_link 的 -Y 侧(立柱/机械臂那一侧)
       安装位姿(把上一版的解绕 Z 转 180 度得到, 数值经 Chamfer 验证 2.47 mm):
         用"整条臂的网格形状配准"定出基座坐标系到装配坐标系的变换, 再做逐点 Chamfer 验证:
             中位误差 2.47 mm  (网格细分级别, 即精确吻合)
         对比: 之前 rpy 用 -pi/2 时误差 45.6 mm; 之前的 xyz 误差 34.3 mm。
       注意: 官方 base_link 的坐标系与 CAD 里 J12 零件的坐标系轴序不同, 所以姿态不能直接
             照抄零件, 必须像上面这样按几何配准求。
       换算到 base_link:
         arm1 xyz = (-0.187589, 0.248698, 0.027595)
         arm2 xyz = ( 0.190143, 0.247318, 0.027595)
         rpy      = (0, 0, 1.5707963)    +pi/2, 不是 pi/2 的反号
       两臂相距 377.732 mm (沿 X); 在 Y 上 arm1 比 arm2 靠前 1.380 mm(建模本身如此, 非对称)。
       臂的包络(base_link): X -236..-139 / 142..239, Y -66..306, Z 27.6..267.2 mm -->
  <xacro:piper_arm prefix="${arm1_prefix}" parent="lift_platform_link">
    <origin xyz="0.187732 -0.249047 0.032000" rpy="0 0 -1.5707963"/>
  </xacro:piper_arm>
  <xacro:piper_arm prefix="${arm2_prefix}" parent="lift_platform_link">
    <origin xyz="-0.190000 -0.247667 0.032000" rpy="0 0 -1.5707963"/>
  </xacro:piper_arm>
  <!-- 旧版底盘 2D 雷达 / 相机定义仍保留在 sensors_disabled.xacro，仅作历史参考。 -->

  <!-- <gazebo reference="base_link"><material>Gazebo/Grey</material></gazebo>   (已由 .obj 自带颜色取代; 若 Gazebo 不认 .obj 材质, 把这几行解开即可) -->
  <xacro:macro name="wheel_gz" params="i">
    <gazebo reference="wheel_${i}">
      <mu1>1.2</mu1><mu2>1.2</mu2><!-- 材质由 wheel_*.obj 自带 -->
    </gazebo>
  </xacro:macro>
  <xacro:wheel_gz i="1"/><xacro:wheel_gz i="2"/>
  <xacro:wheel_gz i="3"/><xacro:wheel_gz i="4"/>

  <xacro:if value="$(arg use_gazebo)">
    <xacro:include filename="$(find ag_robot_description)/urdf/gazebo.xacro"/>
  </xacro:if>

</robot>
