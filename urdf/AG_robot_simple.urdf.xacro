<?xml version="1.0"?><!-- =====================================================================
     AG_robot 简化版 (跑得动的那一版)  —— 2026-09-26

     这是什么
       与 AG_robot.urdf.xacro 同在一条车里, **只是几何换成了图元**:
         · 关节(name/type/parent/child/origin/axis/limit/dynamics) —— 逐字节照搬, 一个字没改
         · 质量与惯量(含质心) —— 逐字节照搬, 所以整车质量、质心、动力学与原来完全一致
         · 传感器 —— 直接 include 同一份 urdf/gazebo.xacro, VLP-16 的位置/参数
                     (16 线/360°/±20°/0.5–200 m/10 Hz/1800×16/σ=1 cm) 与原来一模一样
         · ros2_control —— 同一份 include + 同一份 config/ros2_control.yaml, 控制器与关节名不变
         · 几何 —— 原 33 个网格(约 125 万面) 全部换成 box / cylinder,
                   每个图元的尺寸都取自原网格的**实测包围盒**(逐条注明在下面)

     为什么要它
       原模型整车约 125 万面(车体+轮 ≈91 万, 轮子各 92,096 面), 仿真实时率只有约 0.5×,
       10 Hz 的雷达实际只有约 3.7 Hz。换成图元后渲染/碰撞/雷达射线都不再遍历三角形。

     尺寸怎么保证"与原来相当"
       每个 link 的图元组合起来的包围盒 = 原网格的包围盒(见每条注释里的实测值),
       所以整车外形尺寸不变; 差的是内部细节(倒角/螺孔/线槽/看不见的内部件)。
       数量对照(用 scripts/compare_models.py 可随时复算):
         整车轮距 603.8 / 轴距 400.0 / 轮径 Ø226.99 / 轮心高 218.49 mm —— 全部不变(由关节决定)
         立柱顶面 z=0.911 m —— 不变(雷达就坐在这个面上)

     坐标系(本文件内部) = SolidWorks 装配体坐标: +X = 左右, +Y = 车头方向, +Z = 竖直向上
       (与 AG_robot.urdf.xacro 完全一致, base_joint 用 rpy=(0,0,-pi/2) 转进 ROS)

     本文件**不引用任何网格文件**, 所以不需要 meshes/ 目录、也不受 GZ_SIM_RESOURCE_PATH 影响。

     用法
       ros2 launch ag_robot_description gazebo_simple.launch.py lidar_pitch:=25
       (或 ros2 launch ag_robot_description gazebo.launch.py model:=simple ...)
     ===================================================================== -->
<robot name="AG_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ag_robot_description)/urdf/piper_arm_simple.xacro"/>

  <xacro:arg name="lift_travel" default="0.40"/>
  <xacro:arg name="use_gazebo"  default="false"/>
  <xacro:arg name="arm1_prefix" default="arm1_"/>
  <xacro:arg name="arm2_prefix" default="arm2_"/>
  <!-- ═════════ 雷达安装倾角（参数化, 供 SLAM 对比四种姿态）═════════
       与 AG_robot.urdf.xacro 中的定义逐字相同: lidar_pitch 单位度, 正值 = 朝车头下倾。
       z(pitch) = 0.911 + (h/2)·cos(pitch) + r·sin(pitch),  h=0.072, r=0.0445
       (立柱顶面 z=0.911 m 在两个模型里都是同一个面, 所以这个公式照样成立) -->
  <xacro:arg name="lidar_pitch" default="0"/>
  <xacro:property name="lidar_pitch_deg" value="$(arg lidar_pitch)"/>
  <xacro:property name="lidar_pitch_rad" value="${radians(float(lidar_pitch_deg))}"/>
  <xacro:property name="velodyne_z"
                  value="${0.911 + 0.036*cos(lidar_pitch_rad) + 0.0445*sin(lidar_pitch_rad)}"/>
  <xacro:property name="arm1_prefix" value="$(arg arm1_prefix)"/>
  <xacro:property name="arm2_prefix" value="$(arg arm2_prefix)"/>

  <!-- 色表与 AG_robot.urdf.xacro 完全一致(改配色时两个文件一起改)。
       注意: 下面每个 <visual> 都会**再写一遍内联颜色** —— sdformat 把 URDF 转 SDF 时,
       同一 link 里第二个及以后的 visual 若只按名字引用材质, diffuse 会变成纯黑。 -->
  <material name="grey"><color rgba="0.28 0.30 0.34 1.0"/></material>
  <material name="steel"><color rgba="0.52 0.54 0.57 1.0"/></material>
  <material name="black"><color rgba="0.06 0.06 0.07 1.0"/></material>
  <material name="blue"><color rgba="0.20 0.40 0.90 1.0"/></material>
  <material name="red"><color rgba="0.85 0.20 0.20 1.0"/></material>
  <material name="alu"><color rgba="0.78 0.79 0.81 1.0"/></material>
  <material name="dark"><color rgba="0.22 0.22 0.24 1.0"/></material>
  <material name="velodyne_blue"><color rgba="0.05 0.22 0.42 1.0"/></material>
  <material name="accent"><color rgba="0.13 0.42 0.85 1.0"/></material>

  <!-- ───────── 图元宏: visual 与 collision 共用一份几何 ───────── -->
  <xacro:macro name="ag_box" params="size xyz mat rgba">
    <visual>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <geometry><box size="${size}"/></geometry>
      <material name="${mat}"><color rgba="${rgba}"/></material>
    </visual>
    <collision>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <geometry><box size="${size}"/></geometry>
    </collision>
  </xacro:macro>

  <!-- 图元宏: visual 与 collision 共用一份几何。
       参数名用 lng 而不是 len —— xacro 内部要用 Python 的 len(), 用 len 当参数名会
       每次实例化都打印 "warning: redefining global symbol: len" (不影响结果, 但很吵)。 -->
  <xacro:macro name="ag_cyl" params="rad lng xyz rpy mat rgba">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><cylinder radius="${rad}" length="${lng}"/></geometry>
      <material name="${mat}"><color rgba="${rgba}"/></material>
    </visual>
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><cylinder radius="${rad}" length="${lng}"/></geometry>
    </collision>
  </xacro:macro>

  <!-- ═════════ base_footprint: 地面投影, Nav2 用 ═════════
       轮子最低点在 base_link 里是 z=-218.49, 所以 base_link 抬高 218.49 mm —— 与原来同。 -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.2184858" rpy="0 0 1.5707963"/>
  </joint>

  <!-- ═════════ base_link: 底盘 ═════════
       原 chassis.stl (372,530 面) + rail.stl (7,904 面) 压缩成 7 个长方体。
       每个长方体的尺寸/位置都是原网格"连通件"的实测包围盒(用 scipy 连通域分解量的),
       7 块并集的包围盒 = 原两网格并集的包围盒:
         X ±273.5, Y ±275.0, Z -141.49..37.0 mm   (原)  vs  X ±273.5, Y ±275.0, Z -139.99..37.0 (本文件)
         (差的 1.5 mm 是原底盘最下面那张 300×290×1.5 的底板, 略去)
       惯量照搬原值(19.352 kg / 质心 (0,0,-0.052246)) —— 图元几何与网格几何足够接近,
       换算法反而会让动力学与原来对不上。 -->
  <link name="base_link">
    <!-- ① 车架: 顶板 460×550×2 (Z 0..2) + 4 根 2020 型材 (|X| 210..250, Z -20..0)
           + 4 根 2040 横梁 (Z -20..0) 的并集 -->
    <xacro:ag_box size="0.500 0.550 0.022" xyz="0 0 -0.009"
                  mat="grey" rgba="0.28 0.30 0.34 1.0"/>
    <!-- ② 四套独立悬挂/轮毂总成: 原 4 个连通件, 各 261.5 × 148.0 × 120.0 mm
           前轴 Y -272.983..-125.0 (中心 -198.99), 后轴 Y 127.017..275.0 (中心 201.01)
           注意外沿 |X|=273.5 < 轮子内侧面 253.5+... : 轮毂正好伸进轮子里, 与原来一致 -->
    <xacro:ag_box size="0.2615 0.1479832 0.120" xyz="-0.14275 -0.1989916 -0.0799916"
                  mat="grey" rgba="0.28 0.30 0.34 1.0"/>
    <xacro:ag_box size="0.2615 0.1479832 0.120" xyz=" 0.14275 -0.1989916 -0.0799916"
                  mat="grey" rgba="0.28 0.30 0.34 1.0"/>
    <xacro:ag_box size="0.2615 0.1479832 0.120" xyz="-0.14275  0.2010084 -0.0799916"
                  mat="grey" rgba="0.28 0.30 0.34 1.0"/>
    <xacro:ag_box size="0.2615 0.1479832 0.120" xyz=" 0.14275  0.2010084 -0.0799916"
                  mat="grey" rgba="0.28 0.30 0.34 1.0"/>
    <!-- ③ 底盘下方中央的电池/电控总成: 原连通件 177.0 × 164.29 × 42.4 mm
           (原文件里那 205,888 面的"细节王"件就在这一块里, 简化后整块略过) -->
    <xacro:ag_box size="0.177 0.1642868 0.0424" xyz="-0.0595 -0.0408566 -0.1187916"
                  mat="grey" rgba="0.28 0.30 0.34 1.0"/>
    <!-- ④ 固定在底盘上的平置导轨 (原 rail.stl, 500 × 330 × 36.5 mm, 铝色)
           原文件里它是单独的 visual 就是为了保持亮铝色, 这里同样是独立的一块 -->
    <xacro:ag_box size="0.500 0.330 0.0365" xyz="0 0.110 0.01875"
                  mat="alu" rgba="0.78 0.79 0.81 1.0"/>
    <inertial>
      <origin xyz="0.000000 0.000000 -0.052246" rpy="0 0 0"/>
      <mass value="19.352"/>
      <inertia ixx="0.539215" ixy="0" ixz="0" iyy="0.533908" iyz="0" izz="0.970366"/>
    </inertial>
  </link>

  <!-- ═════════ imu_link: IMU 坐标系 (与原来完全一致: 只有坐标, 无几何) ═════════
       IMU 集成在主控(Orin)上、没有独立安装件。X=0, Y=0, Z = base_link 下方 0.0754 m。 -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 -0.0754" rpy="0 0 0"/>
  </joint>

  <!-- ═════════ wheel_1..4: 四轮 ═════════
       原 wheel_*.stl 各 92,096 面(实心胎, 回转体) -> 一个圆柱。
       实测(网格, 轮子自身坐标系): 半径 113.4942 mm, 胎宽 y = -34.0..+34.0 mm, 轴沿 Y。
       所以: 半径 0.1134942 (= ros2_control.yaml 里的 wheel_radius 0.11349, 一模一样),
             长 0.068, 居中于轮心 —— 轮子最低点仍是 base_link 的 -0.2184858, 车身高度不变。
       原来还有一段 y=37..48.4 的轮轴凸出(r≤15mm), 它伸进悬挂盒里、看不见, 略去。
       关节(continuous/axis 0±1 0/effort 50/velocity 20/damping 0.01/friction 0.1)与原来逐字相同。 -->
  <xacro:macro name="wheel_link" params="i">
    <link name="wheel_${i}">
      <xacro:ag_cyl rad="0.1134942" lng="0.068" xyz="0 0 0" rpy="1.5707963 0 0"
                    mat="black" rgba="0.06 0.06 0.07 1.0"/>
      <inertial>
        <origin xyz="0 0.0072004 0" rpy="0 0 0"/>
        <mass value="5.471"/>
        <inertia ixx="0.026585" ixy="0" ixz="0" iyy="0.046979" iyz="0" izz="0.026585"/>
      </inertial>
    </link>
  </xacro:macro>
  <xacro:wheel_link i="1"/><xacro:wheel_link i="2"/>
  <xacro:wheel_link i="3"/><xacro:wheel_link i="4"/>

  <joint name="wheel_1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_1"/>
    <origin xyz="-0.3019 0.2010084 -0.1049916" rpy="0 0.2807556 -1.5707963"/>
    <axis xyz="0 -1 0"/>
    <limit effort="50" velocity="20"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <joint name="wheel_2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_2"/>
    <origin xyz="0.3019 0.2010084 -0.1049916" rpy="0 0.2807556 1.5707963"/>
    <axis xyz="0 1 0"/>
    <limit effort="50" velocity="20"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <joint name="wheel_3_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_3"/>
    <origin xyz="-0.3019 -0.1989916 -0.1049916" rpy="0 0.2807556 -1.5707963"/>
    <axis xyz="0 -1 0"/>
    <limit effort="50" velocity="20"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <joint name="wheel_4_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_4"/>
    <origin xyz="0.3019 -0.1989916 -0.1049916" rpy="0 0.2807556 1.5707963"/>
    <axis xyz="0 1 0"/>
    <limit effort="50" velocity="20"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <!-- ═════════ base_frame_link: 立柱 (+ 后侧导轨) (固定) ═════════
       原 base_frame.stl 117,138 面 -> 1 个立柱体 + 3 个导轨块。
       立柱体 X ±75, Y -172.4..-86.8, Z 2..911 mm: 由原来两块立柱板(Y -127.5..-87 与
       -172.4..-126.8, 即"立柱本体+FBX150 推杆")、顶板(Y -174.8..-86.8, Z 893..911)、
       底板(Z 2..14) 四件并成。**顶面 z=0.911 m 与原来严格相同** —— 雷达就坐在这个面上。
       注: 原模型中藏在立柱内部的两根 Φ17×839 导杆、20×20 内衬、T 型螺母等已略去(完全看不见)。
       后侧导轨 = 原来 3 个连通件: 底部横导轨 500×30×30 (Z 2..32) + 两根竖直 3030 300mm
       (X ±(75..105), Z 32..332), 它们固定在立柱上、不随升降台动。 -->
  <link name="base_frame_link">
    <!-- ① 立柱本体 + 推杆(合成一块) -->
    <xacro:ag_box size="0.150 0.0856 0.909" xyz="0 -0.1296 0.4565"
                  mat="steel" rgba="0.52 0.54 0.57 1.0"/>
    <!-- ② 后侧底部横导轨 (500 mm) -->
    <xacro:ag_box size="0.500 0.030 0.030" xyz="0 -0.070 0.017"
                  mat="steel" rgba="0.52 0.54 0.57 1.0"/>
    <!-- ③ 后侧两根竖直 3030 型材 (300 mm) -->
    <xacro:ag_box size="0.030 0.030 0.300" xyz="-0.090 -0.070 0.182"
                  mat="steel" rgba="0.52 0.54 0.57 1.0"/>
    <xacro:ag_box size="0.030 0.030 0.300" xyz=" 0.090 -0.070 0.182"
                  mat="steel" rgba="0.52 0.54 0.57 1.0"/>
    <inertial>
      <origin xyz="0.000000 -0.114898 0.455004" rpy="0 0 0"/>
      <mass value="25.293"/>
      <inertia ixx="1.783345" ixy="0" ixz="0" iyy="2.280038" iyz="0" izz="0.557192"/>
    </inertial>
  </link>

  <joint name="base_frame_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_frame_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ═════════ lift_platform_link: 升降台 (滑动) ═════════
       原 platform.stl 44,494 面 / 28 个连通件 -> 5 个长方体。
       ① 两块 Γ 形机械臂托板: 各 100 × 180 × 30 mm, 顶面 Z=32 就是机械臂安装面
          (原来左板 Y -295.096..-115.096、右板 Y -293.278..-113.278, 二者差 1.82 mm 是建模本身
           就不对称, 这里照原样保留)
       ② 前方横导轨 300×30×30 (Z 2..32) + ③ 两根竖直 3030 200mm (X ±(35.5..65.5), Z 32..232)
       —— 这三件+两块托板在 Y 方向都在立柱前方(Y -295..-113), 与立柱体(Y -172.4..-86.8)
          不重叠, 所以升降时不会互穿(原模型靠内部的滑套/滑座导向, 那些件在立柱内部、已略去)。
       关节: prismatic, axis (0,0,1), travel 由 lift_travel 参数给, 限位/effort/velocity/
       damping/friction 与原来逐字相同。 -->
  <joint name="lift_joint" type="prismatic">
    <parent link="base_frame_link"/>
    <child link="lift_platform_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="$(arg lift_travel)" effort="2000" velocity="0.15"/>
    <dynamics damping="50.0" friction="20.0"/>
  </joint>

  <link name="lift_platform_link">
    <!-- ① 机械臂托板 (左 X -250..-150 / 右 X 150..250, 顶面 Z=32) -->
    <xacro:ag_box size="0.100 0.180 0.030" xyz="-0.200 -0.2050963 0.017"
                  mat="alu" rgba="0.78 0.79 0.81 1.0"/>
    <xacro:ag_box size="0.100 0.180 0.030" xyz=" 0.200 -0.2032778 0.017"
                  mat="alu" rgba="0.78 0.79 0.81 1.0"/>
    <!-- ② 前方横向导轨 (300 mm, Z 2..32) -->
    <xacro:ag_box size="0.300 0.030 0.030" xyz="0 -0.1919963 0.017"
                  mat="alu" rgba="0.78 0.79 0.81 1.0"/>
    <!-- ③ 前方两根竖直 3030 型材 (200 mm, Z 32..232) -->
    <xacro:ag_box size="0.030 0.030 0.200" xyz="-0.0505 -0.1919963 0.132"
                  mat="alu" rgba="0.78 0.79 0.81 1.0"/>
    <xacro:ag_box size="0.030 0.030 0.200" xyz=" 0.0505 -0.1919963 0.132"
                  mat="alu" rgba="0.78 0.79 0.81 1.0"/>
    <inertial>
      <origin xyz="0.000000 -0.202447 0.117000" rpy="0 0 0"/>
      <mass value="3.602"/>
      <inertia ixx="0.026183" ixy="0" ixz="0" iyy="0.090914" iyz="0" izz="0.085342"/>
    </inertial>
  </link>

  <!-- ═════════ Velodyne VLP-16 3D 激光雷达（与原来完全一致）═════════
       原来就是圆柱图元, 所以这里一字不改: 直径 89 mm、高 72 mm、质量 0.59 kg,
       安装位姿由 lidar_pitch 参数驱动, 见文件开头。Gazebo 的 16 线扫描器定义在
       urdf/gazebo.xacro (本模型 include 的就是那份文件)。 -->
  <link name="velodyne_link">
    <visual>
      <geometry><cylinder radius="0.0445" length="0.072"/></geometry>
      <material name="velodyne_blue"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.0445" length="0.072"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.59"/>
      <inertia ixx="0.000547" ixy="0" ixz="0"
               iyy="0.000547" iyz="0" izz="0.000584"/>
    </inertial>
  </link>

  <joint name="velodyne_joint" type="fixed">
    <parent link="base_frame_link"/>
    <child link="velodyne_link"/>
    <!-- 位姿由 lidar_pitch 参数驱动, 与 AG_robot.urdf.xacro 里的公式逐字相同 -->
    <origin xyz="0 -0.114898 ${velodyne_z}" rpy="${lidar_pitch_rad} 0 0"/>
  </joint>

  <!-- ═════════ 两条松灵 PiPER 六轴臂 ═════════
       几何换成图元(见 urdf/piper_arm_simple.xacro), 关节 origin/限位/惯量与原来逐字相同:
         arm1 xyz = ( 0.187732, -0.249047, 0.032)  rpy = (0, 0, -1.5707963)
         arm2 xyz = (-0.190000, -0.247667, 0.032)  rpy = (0, 0, -1.5707963)
       两臂相距 377.732 mm(沿 X), 臂的包络尺寸(每个连杆的包围盒)与原来一致。 -->
  <xacro:piper_arm_simple prefix="${arm1_prefix}" parent="lift_platform_link">
    <origin xyz="0.187732 -0.249047 0.032000" rpy="0 0 -1.5707963"/>
  </xacro:piper_arm_simple>
  <xacro:piper_arm_simple prefix="${arm2_prefix}" parent="lift_platform_link">
    <origin xyz="-0.190000 -0.247667 0.032000" rpy="0 0 -1.5707963"/>
  </xacro:piper_arm_simple>

  <!-- 轮子摩擦系数 (与 AG_robot.urdf.xacro 相同; gazebo.xacro 里另有一份同样的定义,
       两份都会被 sdformat 合并, 值一致所以无冲突 —— 保持与原文件相同的写法) -->
  <xacro:macro name="wheel_gz" params="i">
    <gazebo reference="wheel_${i}">
      <mu1>1.2</mu1><mu2>1.2</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_gz i="1"/><xacro:wheel_gz i="2"/>
  <xacro:wheel_gz i="3"/><xacro:wheel_gz i="4"/>

  <!-- ⚠ 关键: 复用**原来那份** gazebo.xacro。里面是:
       VLP-16 的 <sensor type="gpu_lidar"> (16 线/360°/±20°/0.5–200 m/10 Hz/1800×16/σ=1cm)
       + ros2_control 的关节接口 + gz_ros2_control 插件。
       复用同一个文件 = 传感器与控制器参数不可能被改错。 -->
  <xacro:if value="$(arg use_gazebo)">
    <xacro:include filename="$(find ag_robot_description)/urdf/gazebo.xacro"/>
  </xacro:if>

</robot>
