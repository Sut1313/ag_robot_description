<?xml version="1.0"?><!-- =====================================================================
     AgileX PiPER 六轴臂 —— 简化几何版 (2026-09-26)

     与同目录 piper_arm.xacro (官方几何版) 的关系是 **"只换皮、不动骨架"**:
       · 关节 name/type/parent/child/origin/axis/limit/dynamics —— 逐字节照搬, 未做任何改动
       · 惯量(质量/质心/完整惯量张量) —— 官方值原样照搬, 所以动力学与原来完全一致
       · 几何 —— 官方 .dae(视觉)/.stl(碰撞) 网格 -> 圆柱或长方体, 每个连杆 1 个图元

     每个图元的尺寸都来自**官方网格的实测包围盒**(下面对每个 link 都注明了原始尺寸),
     所以臂的轮廓与包络尺寸与原来一致, 丢掉的只是内部的机械细节(倒角、电机、线缆槽…)。

     性能: 官方一条臂 8 个网格 14.9 MB (.dae) + 8.5 MB (.stl), 约 35.0 万面; 车上两条臂共 16 个网格、约 70 万面;
     换成图元后, 渲染/碰撞/雷达射线都不再需要遍历网格三角形。

     坐标系与官方定义完全一致(base_link 原点在 J1 轴线上, +Z 为 J1 轴), 所以调用方的
     安装 origin 不需要任何改动。
     ===================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 本文件的两个图元宏 ag_box / ag_cyl 与色表由调用方提供
       (AG_robot_simple.urdf.xacro 顶部定义; 与官方 piper_arm.xacro 要求调用方提供
        alu/dark/accent 三个材质是一回事)。宏体里每个 visual 自带内联颜色, 因为
       sdformat 把 URDF 转 SDF 时, 同一 link 里第二个及以后的 visual 若只按名字引用
       材质, diffuse 会被转成纯黑。 -->
  <xacro:macro name="piper_arm_simple" params="prefix parent *origin">

    <!-- ───────── base_link (臂座) ─────────
         官方网格包围盒: 98.5 × 80.0 × 86.0 mm, 中心 (-9.25, 0, 43) mm
         原来是一块带圆角的底座 + 中间圆柱凸台; 简化成长方体, 外形尺寸不变 -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-0.00473641164191482 2.56829134630247E-05 0.041451518036016" rpy="0 0 0"/>
        <mass value="1.02"/>
        <inertia ixx="0.00267433" ixy="-0.00000073" ixz="-0.00017389" iyy="0.00282612" iyz="0.0000004" izz="0.00089624"/>
      </inertial>
      <xacro:ag_box size="0.0985 0.08 0.086" xyz="-0.00925 0 0.043"
                   mat="alu" rgba="0.78 0.79 0.81 1.0"/>
    </link>
    <!-- ───────── link1 (J1 转台) ─────────
         官方网格包围盒: 71.86 × 77.5 × 73.0 mm, 中心 (0.055, 2, -6.5) mm -->
    <link name="${prefix}link1">
      <inertial>
        <origin xyz="0.00032 -0.00041 -0.00348" rpy="0 0 0"/>
        <mass value="0.71"/>
        <inertia ixx="0.00050027" ixy="0.00000078" ixz="0.00000626" iyy="0.00040879" iyz="0.00000462" izz="0.00045802"/>
      </inertial>
      <xacro:ag_box size="0.071863 0.0775 0.073" xyz="0.0000545 0.002 -0.0065"
                   mat="dark" rgba="0.22 0.22 0.24 1.0"/>
    </link>
    <!-- ───────── link2 (大臂, 长杆沿 +X) ─────────
         官方网格包围盒: 347.97 (X) × 96.53 (Y) × 97.0 (Z) mm, 中心 (142.522, -16.548, 0) mm
         原来是一根圆角方管(截面 96.5×97) + 末端关节壳; 简化成沿 X 的圆柱, 半径取截面的一半 -->
    <link name="${prefix}link2">
      <inertial>
        <origin xyz="0.21852 -0.00861 0.00126" rpy="0 0 0"/>
        <mass value="1.16"/>
        <inertia ixx="0.00111915" ixy="0.00182916" ixz="0.00019233" iyy="0.06763251" iyz="0.00000767" izz="0.067559"/>
      </inertial>
      <xacro:ag_cyl rad="0.0485" lng="0.347971" xyz="0.1425225 -0.016548 0" rpy="0 1.5707963 0"
                    mat="accent" rgba="0.13 0.42 0.85 1.0"/>
    </link>
    <!-- ───────── link3 (小臂, 长杆沿 -Y) ─────────
         官方网格包围盒: 86.05 (X) × 244.72 (Y) × 80.75 (Z) mm, 中心 (-13.109, -92.391, 0.375) mm -->
    <link name="${prefix}link3">
      <inertial>
        <origin xyz="-0.01999 -0.14808 -0.00053" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.01347608" ixy="0.00161034" ixz="0.00000066" iyy="0.00046377" iyz="0.00000162" izz="0.01363321"/>
      </inertial>
      <xacro:ag_cyl rad="0.0430255" lng="0.244722" xyz="-0.0131085 -0.092391 0.000375" rpy="-1.5707963 0 0"
                    mat="alu" rgba="0.78 0.79 0.81 1.0"/>
    </link>
    <!-- ───────── link4 (腕部转座) ─────────
         官方网格包围盒: 62.71 × 61.08 × 64.45 mm, 中心 (-1.513, 2.043, -3.776) mm -->
    <link name="${prefix}link4">
      <inertial>
        <origin xyz="0.00013 -0.00076 -0.00394" rpy="0 0 0"/>
        <mass value="0.38"/>
        <inertia ixx="0.00017844" ixy="0.00000062" ixz="0.00000067" iyy="0.00018914" iyz="0.00000408" izz="0.00014613"/>
      </inertial>
      <xacro:ag_box size="0.062711 0.06108 0.064448" xyz="-0.0015125 0.002043 -0.003776"
                   mat="dark" rgba="0.22 0.22 0.24 1.0"/>
    </link>
    <!-- ───────── link5 (腕部, 短杆沿 -Y) ─────────
         官方网格包围盒: 59.96 (X) × 113.48 (Y) × 60.92 (Z) mm, 中心 (0, -33.261, -1.958) mm -->
    <link name="${prefix}link5">
      <inertial>
        <origin xyz="0.00018 -0.06104 -0.00227" rpy="0 0 0"/>
        <mass value="0.383"/>
        <inertia ixx="0.00172318" ixy="0.00000259" ixz="0.00000010" iyy="0.00017936" iyz="0.00000990" izz="0.00171172"/>
      </inertial>
      <xacro:ag_cyl rad="0.03049" lng="0.113479" xyz="0 -0.0332605 -0.001958" rpy="-1.5707963 0 0"
                    mat="accent" rgba="0.13 0.42 0.85 1.0"/>
    </link>
    <!-- ───────── link6 (末端法兰盘) ─────────
         官方网格包围盒: 34.94 × 34.97 × 4.0 mm (薄圆盘), 中心 (-0.06, 0.009, -2) mm -->
    <link name="${prefix}link6">
      <inertial>
        <origin xyz="-0.00003 0.00006 -0.002" rpy="0 0 0"/>
        <mass value="0.007"/>
        <inertia ixx="0.00152112" ixy="0.00000202" ixz="0.00000261" iyy="0.00138626" iyz="0.00000002" izz="0.00031152"/>
      </inertial>
      <xacro:ag_cyl rad="0.01749" lng="0.004" xyz="-0.00006 0.000009 -0.002" rpy="0 0 0"
                    mat="dark" rgba="0.22 0.22 0.24 1.0"/>
    </link>
    <!-- 安装: 由调用者给出 origin (base_link 的原点在 J1 轴线上, +Z 就是 J1 轴) -->
    <joint name="${prefix}mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <joint name="${prefix}joint1" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link1"/>
      <origin xyz="0 0 0.123" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.6179938" upper="2.6179938" effort="100" velocity="5"/>
      <dynamics damping="0.3" friction="0.1"/>
    </joint>
    <joint name="${prefix}joint2" type="revolute">
      <parent link="${prefix}link1"/>
      <child link="${prefix}link2"/>
      <origin xyz="0 0 0" rpy="1.5707963 -0.1357866 -3.1415926"/>
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="3.1415926" effort="100" velocity="5"/>
      <dynamics damping="0.3" friction="0.1"/>
    </joint>
    <joint name="${prefix}joint3" type="revolute">
      <parent link="${prefix}link2"/>
      <child link="${prefix}link3"/>
      <origin xyz="0.28503 0 0" rpy="0 0 -1.7938494"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.9670597" upper="0" effort="100" velocity="5"/>
      <dynamics damping="0.3" friction="0.1"/>
    </joint>
    <joint name="${prefix}joint4" type="revolute">
      <parent link="${prefix}link3"/>
      <child link="${prefix}link4"/>
      <origin xyz="-0.02198 -0.25075 0" rpy="1.5707963 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.7453292" upper="1.7453292" effort="100" velocity="5"/>
      <dynamics damping="0.3" friction="0.1"/>
    </joint>
    <joint name="${prefix}joint5" type="revolute">
      <parent link="${prefix}link4"/>
      <child link="${prefix}link5"/>
      <origin xyz="0 0 0" rpy="-1.5707963 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.2217304" upper="1.2217304" effort="100" velocity="5"/>
      <dynamics damping="0.3" friction="0.1"/>
    </joint>
    <joint name="${prefix}joint6" type="revolute">
      <parent link="${prefix}link5"/>
      <child link="${prefix}link6"/>
      <origin xyz="8.8259E-05 -0.091 0" rpy="1.5707963 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.0943951" upper="2.0943951" effort="100" velocity="5"/>
      <dynamics damping="0.3" friction="0.1"/>
    </joint>
    <!-- ───────── flange_link (官方 piper_with_gripper_description.xacro 里的定义) ─────────
         官方网格包围盒: 56.99 × 56.98 × 10.5 mm 的圆盘, 中心 (-0.005, 0, 5.25) mm -->
    <link name="${prefix}flange_link">
      <inertial>
        <origin xyz="1.151691e-03 0.782428e-03 4.798051e-03" rpy="0 0 0"/>
        <mass value="0.04"/>
        <inertia ixx="9.935389e-06" ixy="0.0" ixz="0.0"
                 iyy="10.508003e-06" iyz="0.0" izz="19.652873e-06"/>
      </inertial>
      <xacro:ag_cyl rad="0.028491" lng="0.0105" xyz="-0.000005 0 0.00525" rpy="0 0 0"
                    mat="dark" rgba="0.22 0.22 0.24 1.0"/>
    </link>

    <joint name="${prefix}flange_joint" type="fixed">
      <parent link="${prefix}link6"/>
      <child link="${prefix}flange_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- 末端安装坐标系: 法兰外端面, 以后接夹爪/手爪用这个 frame -->
    <link name="${prefix}tool0"/>
    <joint name="${prefix}link6_to_tool0" type="fixed">
      <parent link="${prefix}flange_link"/>
      <child link="${prefix}tool0"/>
      <origin xyz="0 0 0.0105" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
